# VERPLICHT in productie: een lange, willekeurige tekst (minstens 32 tekens)
# waarmee admin-inlogsessies worden ondertekend. Zonder geldige waarde is
# inloggen in het beheer geblokkeerd. Voorbeeld genereren:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# VERPLICHT bij de eerste start in productie (of als er nog het oude
# standaardwachtwoord in de database staat): kies hier een sterk wachtwoord
# (minstens 10 tekens). Je logt de eerste keer in met dit wachtwoord; het wordt
# dan veilig (gehasht) opgeslagen. Daarna kan je het wijzigen in
# Instellingen -> Wachtwoord wijzigen, en mag je deze variabele verwijderen.
ADMIN_INITIAL_PASSWORD=

# Optioneel: e-mailbevestigingen en -herinneringen via Resend (resend.com).
# Laat leeg om e-mails simpelweg uit te schakelen (de rest blijft werken).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Doeëg Mêin Haore <afspraken@jouw-domein.be>

# Optioneel: geheime sleutel om /api/cron/reminders te beveiligen.
# Nodig als je dagelijkse e-mailherinneringen wil versturen.
CRON_SECRET=kies-een-willekeurige-geheime-waarde

# Optioneel: WhatsApp-herinneringen/bevestigingen via Twilio.
# Laat leeg om WhatsApp uit te schakelen (de rest blijft werken).
# Zie README voor hoe je dit opzet (vraagt Meta/WhatsApp Business-goedkeuring).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
